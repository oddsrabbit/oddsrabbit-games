{
  // The page-prep worker: pixel loops shared with tools/lib/regions.ts, so the
  // tools' rules (no unchecked-index rule), and the worker's globals.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "WebWorker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
