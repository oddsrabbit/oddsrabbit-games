{
  "name": "rabbit-paint",
  "private": true,
  "description": "Rabbit Paint: a tap-to-fill coloring game for OddsRabbit.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "test": "node test.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p tools && tsc --noEmit -p src/worker",
    "prep-page": "node tools/run.mjs prep-page",
    "sample-pages": "node tools/run.mjs sample-pages",
    "build:dev": "SAMPLES=1 node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
