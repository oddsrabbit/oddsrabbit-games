{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // The SDK is a sibling checkout (../apps-sdk), read from source. Types come
    // from the SDK itself (at runtime the game uses the host's `../sdk-v1.js`,
    // so esbuild drops those imports); the shared leaderboard UI is bundled
    // in, the same way rabbit-words bundles it. esbuild reads these paths too.
    "paths": {
      "@oddsrabbit/apps-sdk": ["../apps-sdk/src/sdk/sdk.ts"],
      "@oddsrabbit/apps-sdk/ui/*": ["../apps-sdk/src/ui/*"]
    }
  },
  "include": ["src/**/*", "tools/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
